# ----------------------------------------------------------------------------
# ProcessPilot AI — backend configuration
# Copy to `.env` and adjust. Never commit a populated `.env`.
# ----------------------------------------------------------------------------

# --- Application ---
APP_NAME=ProcessPilot AI
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
# MVP only: when true, unauthenticated requests resolve to the demo user.
MOCK_AUTH_ENABLED=true
MOCK_AUTH_EMAIL=demo@processpilot.ai
MOCK_AUTH_ROLE=admin

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- Database ---
# MVP (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./processpilot.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://processpilot:processpilot@postgres:5432/processpilot
DB_ECHO=false

# --- Storage ---
# local | azure_blob
STORAGE_BACKEND=local
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=processpilot-documents

# --- Azure OpenAI ---
# Run `az login` before starting the app. Your identity needs access to the resource.
# Leave the endpoint blank to run the deterministic mock LLM.
AZURE_OPENAI_ENDPOINT=https://processpilot-ai.services.ai.azure.com/api/projects/ProcessPilot-AI
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_MAX_TOKENS=4096
AZURE_OPENAI_TEMPERATURE=0.2
AZURE_OPENAI_MAX_RETRIES=3
AZURE_OPENAI_TIMEOUT_SECONDS=60
USE_MOCK_LLM=false

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true
# APPLICATIONINSIGHTS_CONNECTION_STRING=
